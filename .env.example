# Copy to .env.local for local overrides (optional).

# API base — omit locally to use Vite proxy (/api/v1 → localhost:8000).
# Required for production when SPA and API are on different hosts (set at build time on Render):
# VITE_API_BASE_URL=https://mss-crm.onrender.com/api/v1

# Inbox realtime via Laravel Reverb (optional)
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
